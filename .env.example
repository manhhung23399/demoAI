# Google Gemini: dùng để phân loại email và trích xuất sản phẩm
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Catalog sản phẩm cần các cột: code, name, price; tùy chọn unit
PRODUCTS_PATH=data/products.xlsx
QUOTES_OUT_DIR=runtime/output/quotes
PRODUCT_MATCH_THRESHOLD=80

# Demo mặc định: tạo JSON giả lập email trả lời trong outbox_replies.
# Đổi thành smtp khi đã cấu hình đủ thông tin SMTP phía dưới.
EMAIL_MODE=json
REPLIES_OUT_DIR=runtime/output/replies

# Flowable UI Docker hiện map 8080:8080. Đổi user/password nếu đã thay mặc định.
FLOWABLE_PROCESS_API_URL=http://localhost:8080/flowable-ui/process-api/runtime/process-instances
FLOWABLE_PROCESS_KEY=emailDigitalWorker
FLOWABLE_USER=admin
FLOWABLE_PASSWORD=test

# SMTP để gửi phản hồi thật. Bỏ trống thì API chỉ trả kết quả, email_sent=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
